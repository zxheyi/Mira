{
  "name": "mira",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mira": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "benchmark:recall": "npm run build --silent && node scripts/run-recall-baseline.mjs",
    "verify:multi-case-research": "npm run build --silent && node scripts/verify-multi-case-research.mjs",
    "verify:research-pilot": "npm run build --silent && node scripts/verify-research-pilot.mjs",
    "verify:target-architecture": "npm run build --silent && node scripts/verify-target-architecture.mjs",
    "dev": "tsx src/index.ts",
    "pretest": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "tsc && chmod +x dist/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist/src",
    "skills"
  ]
}
