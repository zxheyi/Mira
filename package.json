{
  "name": "mira",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mira": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "benchmark:recall": "npm run build --silent && node scripts/run-recall-baseline.mjs",
    "verify:research-pilot": "npm run build --silent && node scripts/verify-research-pilot.mjs",
    "dev": "tsx src/index.ts",
    "pretest": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "tsc && chmod +x dist/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "better-sqlite3": "^11.10.0",
    "commander": "^12.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/src",
    "skills"
  ]
}
